# =============================================================================
# AuraFlora — .gitignore
# =============================================================================

# Secrets — NEVER commit
.env
*.env
!.env.sample

# ── Rust ─────────────────────────────────────────────────────────────────────
/backend/target/

# ── Flutter / Dart ────────────────────────────────────────────────────────────
/mobile/.dart_tool/
/mobile/.flutter-plugins
/mobile/.flutter-plugins-dependencies
/mobile/.packages
/mobile/build/
.gradle/
**/.gradle/
/mobile/android/local.properties
/mobile/android/app/debug.keystore
/mobile/ios/.symlinks/
/mobile/ios/Pods/
/mobile/ios/Runner.xcworkspace/
/mobile/macos/Pods/
/mobile/pubspec.lock
/mobile/*.iml

# ── Docker ───────────────────────────────────────────────────────────────────
/backend/target/

# ── Audio temp files ─────────────────────────────────────────────────────────
/tmp/
*.mp3
!mobile/assets/**/*.mp3

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.iml
.DS_Store
Thumbs.db

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
