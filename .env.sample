# AuraFlora Backend — Environment Variables
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control.

# =============================================================================
# Server
# =============================================================================
PORT=8080
RUST_LOG=info
AUDIO_TEMP_DIR=/tmp/aura-flora-audio

# =============================================================================
# Google AI Studio — Gemma Inference
# Get your key at: https://aistudio.google.com/app/apikey
# =============================================================================
GEMMA_API_KEY=your_google_ai_studio_key_here
GEMMA_MODEL=gemini-2.5-flash

# =============================================================================
# ElevenLabs — Text-to-Speech
# Get your key at: https://elevenlabs.io/app/settings/api-keys
# Recommended voice: "Sarah" (calm, whisper-style, free-tier compatible) — ID: EXAVITQu4vr4xnSDxMaL
# Other free defaults: "Laura" (FGY2WhTYpPnrIDTdsKH5), "George" (JBFqnCBsd6RMkjVDRZzb)
# =============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# =============================================================================
# TabPFN — Acoustic Classification (optional)
# Get access at: https://priorlabs.ai
# If left empty, heuristic fallback classifier is used.
# =============================================================================
TABPFN_API_KEY=your_tabpfn_api_key_here
TABPFN_ENDPOINT=https://api.priorlabs.ai/v1/tabpfn
