{
  "expo": {
    "name": "AuraFlora",
    "slug": "aura-flora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0F0D",
    "splash": {
      "backgroundColor": "#0A0F0D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AuraFlora listens to ambient nature sounds to calculate biophony grounding."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F0D"
      },
      "permissions": [
        "RECORD_AUDIO",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
